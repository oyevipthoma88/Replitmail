# Copy this file to .env and fill in your values
BOT_TOKEN=your_telegram_bot_token_here

# Extra Microsoft (Outlook/Hotmail) mail services — optional.
# Key na ho to woh service skip hoti hai aur sirf 22.do chalta hai.
KOPEECHKA_API_KEY=
KOPEECHKA_SITE=lovable.dev
HOTMAILBOX_API_KEY=
DONGVANFB_API_KEY=
ANYMESSAGE_API_KEY=
ANYMESSAGE_SITE=instagram.com
# Jugaad: bulk kharide accounts (email|password|refresh_token|client_id) har line me
OUTLOOK_ACCOUNTS_FILE=accounts.txt
